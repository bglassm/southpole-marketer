N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

PIPELINE_PORT=8080
TZ=Asia/Seoul
BUILD_TAG=local-dev

APIFY_TOKEN=
APIFY_ACTOR_ID=clockworks/tiktok-scraper
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_RESULTS_PER_PAGE=25
APIFY_MAX_ITEMS=200
APIFY_TIMEOUT_SECONDS=600
APIFY_PROXY_COUNTRY_CODE=None
APIFY_TIKTOK_COMMENTS_ACTOR_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Optional container path overrides for portability/custom layouts.
CONTAINER_OUTPUTS_DIR=/workspace/outputs
OUTPUT_ROOT=/workspace/outputs/runs
OPERATOR_STATE_ROOT=/workspace/outputs/operator_state
N8N_WORKFLOW_MOUNT_DIR=/workspace/n8n/workflows
