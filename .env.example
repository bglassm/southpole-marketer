# Southpole local env template (sanitized)

# n8n auth and encryption
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=

# Apify
APIFY_TOKEN=
APIFY_ACTOR=clockworks/tiktok-scraper
APIFY_RESULTS_PER_PAGE=20
APIFY_TIMEOUT_SECS=600
APIFY_WAIT_FOR_FINISH_SECS=600
MAX_ITEMS_PER_RUN=2000

# Google Sheets
GSHEET_ID=
GSHEET_RAW_TAB=raw_events
GSHEET_DAILY_TAB=daily_metrics
GSHEET_KEYWORD_TAB=keyword_totals
GSHEET_SNIPPETS_TAB=top_snippets

# Postgres for instance #2
POSTGRES2_DB=n8n2
POSTGRES2_USER=n8n2
POSTGRES2_PASSWORD=

# Timezone
TZ=Asia/Seoul
GENERIC_TIMEZONE=Asia/Seoul

# n8n Code node env access
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
